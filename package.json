{
  "name": "agent-wall-webmcp",
  "version": "1.0.0",
  "private": false,
  "type": "module",
  "description": "Fixture-safe Agent Wall WebMCP challenge projection",
  "license": "MIT",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "test": "vitest run",
    "test:contracts": "vitest run tests/contracts.test.ts tests/kernel.test.ts",
    "test:mcp": "npm run build && node scripts/mcp-http-smoke.mjs",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "test:browser": "npm run build && node scripts/browser-smoke.mjs",
    "scrub": "node scripts/scrub.mjs",
    "scrub:bundle": "AGENT_WALL_REQUIRE_BUILD=1 node scripts/scrub.mjs",
    "check": "npm run typecheck && npm test && npm run build && npm run scrub:bundle && npm run test:browser && npm run test:mcp && npm run scrub:bundle",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@noble/hashes": "2.3.0",
    "agents": "0.21.0",
    "zod": "4.2.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260903.1",
    "@types/node": "24.3.0",
    "puppeteer-core": "25.9.0",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "3.2.7",
    "wrangler": "4.128.0"
  }
}
